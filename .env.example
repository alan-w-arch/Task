# General
PORT=3001
NODE_ENV=development

# Database (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scraper_db?schema=public
# Or direct host details for raw SQL connectivity
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=scraper_db
DB_SSL=false

# # Redis (for BullMQ queues)
# REDIS_HOST=https://proven-bass-106838.upstash.io
# REDIS_PORT=6379
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

REDIS_URL=
# NLP / AI Model APIs
GEMINI_API_KEY=your_gemini_api_key_here

# Social Media Platform Credentials (optional / fallback to mock)
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
